# ============================================
# FRONTEND - Variables de entorno para producción (Hostinger + Supabase)
# Copia este archivo a .env y completa los valores
# IMPORTANTE: Las variables del frontend DEBEN empezar con VITE_
# ============================================

# URL de la API del backend
# En Hostinger, si frontend y backend están en el mismo dominio/servidor:
# VITE_API_URL=/api
#
# Si el backend está en subdominio distinto:
# VITE_API_URL=https://api.tu-dominio.com/api
#
# Para desarrollo local:
# VITE_API_URL=http://localhost:4000/api
VITE_API_URL=/api