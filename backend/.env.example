# ============================================
# BACKEND - Variables de entorno para producción (Hostinger + Supabase)
# Copia este archivo a .env y completa los valores
# ============================================

# Entorno
NODE_ENV=production

# Puerto (Hostinger asigna el puerto via variable PORT)
PORT=4000

# ============================================
# BASE DE DATOS - Supabase
# ============================================
# Obtén esto de Supabase Dashboard > Settings > Database > Connection string
# Formato: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:TU_PASSWORD_SUPABASE@db.TU_PROJECT_REF.supabase.co:5432/postgres

# Si Supabase requiere SSL (sí, lo requiere), la URL ya lo incluye con ?sslmode=require
# Si no funciona, prueba agregando: ?sslmode=require al final

# ============================================
# AUTENTICACIÓN JWT
# ============================================
# Genera uno seguro: openssl rand -base64 48
JWT_SECRET=TU_JWT_SECRET_SUPER_SEGURO_AQUI_MINIMO_48_CARACTERES

# Expiración del token (ej: 12h, 24h, 7d)
JWT_EXPIRES=12h

# Minutos de inactividad antes de cerrar sesión (0 = desactivado)
SESSION_IDLE_MINUTES=30

# ============================================
# CORS - Origen permitido para el frontend
# ============================================
# En Hostinger, si frontend y backend están en el mismo dominio, usa '*'
# Si el frontend está en subdominio distinto: https://tu-dominio.hostinger.com
CORS_ORIGIN=*

# ============================================
# OPCIONALES
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info