# ===== Configuración del backend Robles Stock =====
# Copiá este archivo como .env y ajustá los valores.

# Entorno: development | production
NODE_ENV=development

# Puerto de la API
PORT=4000

# Conexión a PostgreSQL (producción: usá SSL y credenciales propias)
DATABASE_URL=postgresql://robles_app:CAMBIA_ESTA_PASSWORD@localhost:5432/robles_stock

# Secreto para firmar los tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Vigencia absoluta del token de sesión (formato de ms, ej: 12h)
JWT_EXPIRES=12h

# Cierre automático por inactividad (minutos). 0 = desactivado
SESSION_IDLE_MINUTES=30

# Origen autorizado del frontend (CORS). En producción: https://tu-dominio
CORS_ORIGIN=http://localhost:5173

# Datos iniciales del usuario administrador (solo los usa db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=robles2026

# Ruta del ejecutable pg_dump para los backups (Windows)
PG_DUMP=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
