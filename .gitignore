# ============================================
# ROBLES STOCK PRO - .gitignore
# ============================================

# Dependencias
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
backend/dist/
frontend/dist/
dist/
public/
*.tsbuildinfo

# Paquetes de despliegue (se regeneran con create_zip_hostinger.ps1)
*.zip
*.rar
README_DEPLOY.txt

# Logs de desarrollo (se escriben con redireccion en consola)
backend/server.err
backend/server.out
backend/server4001.err
backend/server4001.out
frontend/vite.err
frontend/vite.out

# Variables de entorno (NUNCA commitear .env reales)
.env
.env.local
.env.production
.env.*.local
backend/.env
frontend/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/app.log

# IDE y editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/

# Temporal
tmp/
temp/
*.tmp

# Base de datos local (si se usa SQLite o archivos)
*.db
*.sqlite

# Backups
backups/
*.backup
*.bak

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================
# ARCHIVOS QUE SÍ SE COMMITEAN (ejemplos):
# ============================================
# backend/.env.example      ✓
# frontend/.env.example     ✓
# package-lock.json         ✓
# backend/package-lock.json ✓
# frontend/package-lock.json ✓